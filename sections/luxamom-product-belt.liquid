<script>
(function(){
  var root = document.currentScript.previousElementSibling;
  if (!root || !root.classList.contains('lxm-pdp')) { root = document.querySelector('.lxm-pdp'); }
  if (!root) return;

  var variants = [];
  var dataEl = root.querySelector('[data-lxm-variants]');
  try { variants = JSON.parse(dataEl.textContent); } catch (e) { return; }
  if (!variants.length) return;

  var mainImgs = root.querySelectorAll('.lxm-gallery-img');
  var thumbs = root.querySelectorAll('.lxm-thumb');
  var swatches = root.querySelectorAll('.lxm-swatch[data-color]');
  var variantInput = root.querySelector('[data-variant-id-input]');
  var priceNow = root.querySelector('[data-price]');
  var priceInline = root.querySelector('[data-price-inline]');
  var selectedNameEl = root.querySelector('[data-selected-color-name]');
  var stickyPrice = root.querySelector('[data-sticky-price]');
  var priceRow = root.querySelector('.lxm-price-row');
  var addBtn = root.querySelector('[data-add-btn]');
  var addLabel = root.querySelector('[data-add-label]');
  var addErrorEl = root.querySelector('[data-add-error]');

  var state = { color: variants[0].color };
  var active = root.querySelector('.lxm-swatch[data-color].lxm-swatch-active');
  if (active) state.color = active.getAttribute('data-color');

  function findVariant(color) {
    for (var i = 0; i < variants.length; i++) {
      if (variants[i].color === color) return variants[i];
    }
    return null;
  }

  function showAddError(text) {
    if (!addErrorEl) return;
    addErrorEl.textContent = text || '';
    addErrorEl.hidden = !text;
  }

  function showIndexFor(src) {
    if (!src) return;
    var matched = false;
    mainImgs.forEach(function (img) {
      var is = img.getAttribute('data-media-src') === src;
      img.classList.toggle('lxm-active', is);
      if (is) matched = true;
    });
    if (!matched && mainImgs[0]) mainImgs[0].classList.add('lxm-active');
    thumbs.forEach(function (t, i) {
      t.classList.toggle('lxm-thumb-active', mainImgs[i] && mainImgs[i].classList.contains('lxm-active'));
    });
  }

  function render() {
    var v = findVariant(state.color);
    if (!v) return;

    if (variantInput) variantInput.value = v.id;
    if (priceNow) priceNow.textContent = v.priceStr;
    if (priceInline) priceInline.textContent = v.priceStr;
    if (stickyPrice) stickyPrice.textContent = v.priceStr;
    if (selectedNameEl) selectedNameEl.textContent = v.color;

    var wasEl = priceRow.querySelector('[data-compare-price]');
    var offEl = priceRow.querySelector('[data-price-off]');
    if (v.compare > v.price) {
      if (!wasEl) {
        wasEl = document.createElement('span');
        wasEl.className = 'lxm-price-was';
        wasEl.setAttribute('data-compare-price', '');
        priceRow.appendChild(wasEl);
      }
      wasEl.textContent = v.compareStr;
      if (!offEl) {
        offEl = document.createElement('span');
        offEl.className = 'lxm-price-off';
        offEl.setAttribute('data-price-off', '');
        priceRow.appendChild(offEl);
      }
      offEl.textContent = Math.round((v.compare - v.price) * 100 / v.compare) + '% הנחה';
    } else {
      if (wasEl) wasEl.remove();
      if (offEl) offEl.remove();
    }

    // The label lives in its own span so going out of stock and back cannot
    // destroy the price span sharing the button.
    var soldOut = !v.available;
    if (addBtn) addBtn.disabled = soldOut;
    if (addLabel) addLabel.textContent = soldOut ? 'אזל מהמלאי' : 'הוספה לסל';
    if (priceInline) priceInline.style.display = soldOut ? 'none' : '';

    swatches.forEach(function (s) {
      var is = s.getAttribute('data-color') === state.color;
      s.classList.toggle('lxm-swatch-active', is);
      s.setAttribute('aria-pressed', is ? 'true' : 'false');
    });

    showIndexFor(v.img);
  }

  swatches.forEach(function (swatch) {
    swatch.addEventListener('click', function () {
      state.color = swatch.getAttribute('data-color');
      showAddError('');
      render();
    });
  });

  // gallery thumbs
  thumbs.forEach(function (thumb) {
    thumb.addEventListener('click', function () {
      var idx = thumb.getAttribute('data-thumb-index');
      mainImgs.forEach(function (img) {
        img.classList.toggle('lxm-active', img.getAttribute('data-gallery-index') === idx);
      });
      thumbs.forEach(function (t) { t.classList.toggle('lxm-thumb-active', t === thumb); });
    });
  });

  // Tapping the big image is the most natural gesture on a gallery, and doing
  // nothing there is what a session recorder logs as a dead click.
  var galleryMain = root.querySelector('.lxm-gallery-main');
  if (galleryMain && mainImgs.length > 1) {
    var showIndex = function (idx) {
      var s = String(idx);
      mainImgs.forEach(function (img) {
        img.classList.toggle('lxm-active', img.getAttribute('data-gallery-index') === s);
      });
      thumbs.forEach(function (t) {
        t.classList.toggle('lxm-thumb-active', t.getAttribute('data-thumb-index') === s);
      });
    };
    var advance = function () {
      var cur = 0;
      mainImgs.forEach(function (img, i) { if (img.classList.contains('lxm-active')) cur = i; });
      showIndex((cur + 1) % mainImgs.length);
    };
    galleryMain.style.cursor = 'pointer';
    galleryMain.setAttribute('role', 'button');
    galleryMain.setAttribute('tabindex', '0');
    galleryMain.setAttribute('aria-label', 'התמונה הבאה');
    galleryMain.addEventListener('click', advance);
    galleryMain.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); advance(); }
    });
  }

  // Add through the drawer. LXMCart only rejects when the add itself failed, so
  // a rejection here is safe to report rather than retry.
  var pdpForm = root.querySelector('.lxm-pdp-form');
  if (pdpForm) {
    pdpForm.addEventListener('submit', function (e) {
      if (!window.LXMCart) return; // let the browser post the form
      e.preventDefault();
      var v = findVariant(state.color);
      if (!v) return;
      if (addBtn) addBtn.disabled = true;
      showAddError('');
      window.LXMCart.addItem(v.id, 1).then(function () {
        if (addBtn) addBtn.disabled = false;
      }).catch(function (err) {
        if (addBtn) addBtn.disabled = false;
        showAddError((err && err.message !== 'add failed' && err.message) || 'לא הצלחנו להוסיף לסל. נסי שוב.');
      });
    });
  }

  // accordion
  root.querySelectorAll('.lxm-accordion').forEach(function (group) {
    var items = group.querySelectorAll('.lxm-acc-item');
    items.forEach(function (item) {
      var head = item.querySelector('.lxm-acc-head');
      head.addEventListener('click', function () {
        var isOpen = item.classList.contains('lxm-acc-open');
        items.forEach(function (i) { i.classList.remove('lxm-acc-open'); });
        if (!isOpen) item.classList.add('lxm-acc-open');
      });
    });
  });

  // sticky mobile add-to-cart bar
  var stickyBar = root.querySelector('[data-sticky-bar]');
  var mainCta = root.querySelector('.lxm-cta .lxm-btn-primary');
  if (stickyBar && mainCta) {
    var toggleSticky = function () {
      var r = mainCta.getBoundingClientRect();
      stickyBar.classList.toggle('lxm-sticky-visible', r.bottom < 0);
    };
    toggleSticky();
    window.addEventListener('scroll', toggleSticky, { passive: true });
    window.addEventListener('resize', toggleSticky);
    var stickyCta = stickyBar.querySelector('[data-sticky-cta]');
    if (stickyCta) {
      stickyCta.addEventListener('click', function () {
        mainCta.click();
        mainCta.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    }
  }

  render();
})();
</script>

