</section>


<section class="lxm-section" id="faq">
  <div class="lxm-wrap">
    <div class="lxm-section-head">
      <p class="lxm-eyebrow" style="justify-content:center;">שאלות נפוצות</p>
      <h2>כל מה שרצית לדעת על הכרית</h2>
    </div>
    <div class="lxm-accordion lxm-faq-list">
      <div class="lxm-acc-item">
        <button type="button" class="lxm-acc-head">מגיל כמה מתאימה הכרית?
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="lxm-acc-body"><div class="lxm-acc-body-in">
          <p>מתאימה לתינוקות ופעוטות מגיל הישיבה העצמאית ועד גיל ההליכה הבטוחה, בדרך כלל בין 6 ל-24 חודשים. הרצועות המתכווננות מתאימות את הכרית לגדילת הראש.</p>
        </div></div>
      </div>
      <div class="lxm-acc-item">
        <button type="button" class="lxm-acc-head">האם הכרית מגינה מכל נפילה?
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="lxm-acc-body"><div class="lxm-acc-body-in">
          <p>הכרית מרככת פגיעה קלה בנפילה לאחור על הראש והעורף, אך אינה תחליף להשגחה צמודה של מבוגר. יש להשגיח על הפעוט תמיד.</p>
        </div></div>
      </div>
      <div class="lxm-acc-item">
        <button type="button" class="lxm-acc-head">האם קל להלביש את הפעוט עם הכרית?
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="lxm-acc-body"><div class="lxm-acc-body-in">
          <p>כן — הרצועות מתכווננות בקלות ונסגרות באבזם בטיחות פשוט, כך שאפשר להלביש ולהוריד תוך שניות.</p>
        </div></div>
      </div>
      <div class="lxm-acc-item">
        <button type="button" class="lxm-acc-head">איך מכבסים את הכרית?
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="lxm-acc-body"><div class="lxm-acc-body-in">
          <p>מומלץ לנקות בכביסה עדינה ביד או במכונה בשקית כביסה, ולייבש בייבוש טבעי בלבד ללא ייבוש במייבש.</p>
        </div></div>
      </div>
      <div class="lxm-acc-item">
        <button type="button" class="lxm-acc-head">האם ניתן להשתמש בכרית גם בעגלה או במושב רכב?
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="lxm-acc-body"><div class="lxm-acc-body-in">
          <p>הכרית נלבשת ישירות על הגב כמו תרמיל קטן, כך שהיא נעה עם הפעוט בין הליכה, ישיבה ומשחק בבית ובחוץ.</p>
        </div></div>
      </div>
      <div class="lxm-acc-item">
        <button type="button" class="lxm-acc-head">תוך כמה זמן ההזמנה מגיעה?
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="lxm-acc-body"><div class="lxm-acc-body-in">
          <p>המשלוח אורך בממוצע 5-17 ימי עסק, לאחר עיבוד הזמנה של 1-3 ימי עסק. משלוח חינם תמיד, ללא תלות בסכום ההזמנה.</p>
        </div></div>
      </div>
    </div>
  </div>
</section>

<section class="lxm-section" id="reviews">
  <div class="lxm-wrap">
    <div class="lxm-section-head">
      <p class="lxm-eyebrow" style="justify-content:center;">חוות דעת</p>
      <h2>מה אומרות עלינו אמהות</h2>
    </div>
    {% render 'luxamom-reviews' %}

    <div class="lxm-review-form-wrap">
      {% form 'contact', id: 'lxm-review-form' %}
        {% if form.posted_successfully? %}
          <div class="lxm-review-thanks">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 12l5 5L20 6"/></svg>
            <p>תודה! קיבלנו את הביקורת שלך ונפרסם אותה בקרוב.</p>
          </div>
        {% else %}
          <h3 class="lxm-review-form-title">כתבי ביקורת על כרית מגן הראש</h3>
          <input type="hidden" name="contact[product]" value="{{ product.title }} ({{ current_variant.title }})">
          <input type="hidden" name="contact[subject]" value="ביקורת חדשה: {{ product.title }}">

          <div class="lxm-star-rating">
            <span class="lxm-star-rating-label">דירוג:</span>
            <div class="lxm-stars">
              <input type="radio" name="contact[rating]" id="lxm-star-5" value="5" checked><label for="lxm-star-5">★</label>
              <input type="radio" name="contact[rating]" id="lxm-star-4" value="4"><label for="lxm-star-4">★</label>
              <input type="radio" name="contact[rating]" id="lxm-star-3" value="3"><label for="lxm-star-3">★</label>
              <input type="radio" name="contact[rating]" id="lxm-star-2" value="2"><label for="lxm-star-2">★</label>
              <input type="radio" name="contact[rating]" id="lxm-star-1" value="1"><label for="lxm-star-1">★</label>
            </div>
          </div>

          <div class="lxm-review-fields">
            <input type="text" name="contact[name]" placeholder="השם שלך" required>
            <input type="email" name="contact[email]" placeholder="האימייל שלך" required>
            <textarea name="contact[body]" rows="4" placeholder="ספרי לנו איך היה השימוש בכרית..." required></textarea>
          </div>

          <button type="submit" class="lxm-btn lxm-btn-primary">שליחת ביקורת</button>
          <p class="lxm-review-form-note">הביקורת תישלח לצוות LUXAMOM ותפורסם בדף לאחר אישור.</p>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>


<div class="lxm-sticky-bar" data-sticky-bar>
  <span class="lxm-sticky-bar-price" data-sticky-price>{{ current_variant.price | money_without_trailing_zeros }}</span>
  <button type="button" class="lxm-btn lxm-btn-primary" data-sticky-cta>הוספה לסל</button>
</div>

</div>

<script>
(function(){
  var root = document.currentScript.previousElementSibling;
  if (!root || !root.classList.contains('lxm-pdp')) { root = document.querySelector('.lxm-pdp'); }
  if (!root) return;

  var mainImgs = root.querySelectorAll('.lxm-gallery-img');
  var thumbs = root.querySelectorAll('.lxm-thumb');
  thumbs.forEach(function(thumb){
    thumb.addEventListener('click', function(){
      var idx = thumb.getAttribute('data-thumb-index');
      mainImgs.forEach(function(img){
        img.classList.toggle('lxm-active', img.getAttribute('data-gallery-index') === idx);
      });
      thumbs.forEach(function(t){ t.classList.toggle('lxm-thumb-active', t === thumb); });
    });
  });

  // Tapping the big image is the most natural gesture on a gallery, and it used
  // to do nothing at all — a dead click on the largest target of the page.
  var galleryMain = root.querySelector('.lxm-gallery-main');
  if (galleryMain && mainImgs.length > 1) {
    var showIndex = function(idx){
      var s = String(idx);
      mainImgs.forEach(function(img){
        img.classList.toggle('lxm-active', img.getAttribute('data-gallery-index') === s);
      });
      thumbs.forEach(function(t){
        t.classList.toggle('lxm-thumb-active', t.getAttribute('data-thumb-index') === s);
      });
    };
    var advance = function(){
      var cur = 0;
      mainImgs.forEach(function(img, i){ if (img.classList.contains('lxm-active')) cur = i; });
      showIndex((cur + 1) % mainImgs.length);
    };
    galleryMain.style.cursor = 'pointer';
    galleryMain.setAttribute('role', 'button');
    galleryMain.setAttribute('tabindex', '0');
    galleryMain.setAttribute('aria-label', 'התמונה הבאה');
    galleryMain.addEventListener('click', advance);
    galleryMain.addEventListener('keydown', function(e){
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); advance(); }
    });
  }

  var swatches = root.querySelectorAll('.lxm-swatch');
  var variantInput = root.querySelector('[data-variant-id-input]');
  var priceNow = root.querySelector('[data-price]');
  var priceInline = root.querySelector('[data-price-inline]');
  var selectedNameEl = root.querySelector('[data-selected-color-name]');
  var stickyPrice = root.querySelector('[data-sticky-price]');

  swatches.forEach(function(swatch){
    swatch.addEventListener('click', function(){
      swatches.forEach(function(s){ s.classList.toggle('lxm-swatch-active', s === swatch); });
      var vid = swatch.getAttribute('data-variant-id');
      if (variantInput) variantInput.value = vid;

      var price = swatch.getAttribute('data-variant-price');
      var compareRaw = parseFloat(swatch.getAttribute('data-variant-compare-raw') || '0');
      var priceRaw = parseFloat(swatch.getAttribute('data-variant-price-raw') || '0');
      if (priceNow) priceNow.textContent = price;
      if (priceInline) priceInline.textContent = price;
      if (stickyPrice) stickyPrice.textContent = price;
      if (selectedNameEl) selectedNameEl.textContent = swatch.getAttribute('data-variant-name');

      var priceRow = root.querySelector('.lxm-price-row');
      var wasEl = priceRow.querySelector('[data-compare-price]');
      var offEl = priceRow.querySelector('[data-price-off]');
      if (compareRaw > priceRaw) {
        var compareStr = swatch.getAttribute('data-variant-compare');
        var pct = Math.round((compareRaw - priceRaw) * 100 / compareRaw);
        if (!wasEl) {
          wasEl = document.createElement('span');
          wasEl.className = 'lxm-price-was';
          wasEl.setAttribute('data-compare-price', '');
          priceRow.appendChild(wasEl);
        }
        wasEl.textContent = compareStr;
        if (!offEl) {
          offEl = document.createElement('span');
          offEl.className = 'lxm-price-off';
          offEl.setAttribute('data-price-off', '');
          priceRow.appendChild(offEl);
        }
        offEl.textContent = pct + '% הנחה';
      } else {
        if (wasEl) wasEl.remove();
        if (offEl) offEl.remove();
      }

      var img = swatch.getAttribute('data-variant-image');
      if (img) {
        mainImgs.forEach(function(mi){ mi.classList.remove('lxm-active'); });
        var match = null;
        mainImgs.forEach(function(mi){ if (mi.getAttribute('src') === img) match = mi; });
        if (match) {
          match.classList.add('lxm-active');
          thumbs.forEach(function(t){ t.classList.toggle('lxm-thumb-active', t.getAttribute('src') === img); });
        } else if (mainImgs[0]) {
          mainImgs[0].classList.add('lxm-active');
        }
      }
    });
  });

  var pdpForm = root.querySelector('.lxm-pdp-form');
  if (pdpForm) {
    pdpForm.addEventListener('submit', function(e){
      if (!window.LXMCart) return;
      e.preventDefault();
      var vid = variantInput ? variantInput.value : null;
      if (!vid) return;
      var submitBtn = pdpForm.querySelector('.lxm-btn-primary');
      if (submitBtn) submitBtn.disabled = true;
      window.LXMCart.addItem(vid, 1).then(function(){
        if (submitBtn) submitBtn.disabled = false;
      }).catch(function(){
        if (submitBtn) submitBtn.disabled = false;
        pdpForm.submit();
      });
    });
  }

  var accGroups = root.querySelectorAll('.lxm-accordion');
  accGroups.forEach(function(group){
    var items = group.querySelectorAll('.lxm-acc-item');
    items.forEach(function(item){
      var head = item.querySelector('.lxm-acc-head');
      head.addEventListener('click', function(){
        var isOpen = item.classList.contains('lxm-acc-open');
        items.forEach(function(i){ i.classList.remove('lxm-acc-open'); });
        if (!isOpen) item.classList.add('lxm-acc-open');
      });
    });
  });

  var stickyBar = root.querySelector('[data-sticky-bar]');
  var mainCta = root.querySelector('.lxm-cta .lxm-btn-primary');
  if (stickyBar && mainCta) {
    var toggleSticky = function(){
      var r = mainCta.getBoundingClientRect();
      var pastCta = r.bottom < 0;
      stickyBar.classList.toggle('lxm-sticky-visible', pastCta);
    };
    toggleSticky();
    window.addEventListener('scroll', toggleSticky, {passive:true});
    window.addEventListener('resize', toggleSticky);
    var stickyCta = stickyBar.querySelector('[data-sticky-cta]');
    if (stickyCta) {
      stickyCta.addEventListener('click', function(){
        mainCta.click();
        mainCta.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    }
  }
})();
</script>

