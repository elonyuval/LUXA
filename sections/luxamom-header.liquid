<style>
.lxm-header{
  position:sticky; top:0; z-index:150; background:rgba(250,246,241,.92);
  backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px);
  border-bottom:1px solid rgba(139,112,96,.12);
  font-family:'Assistant','Segoe UI',sans-serif; direction:rtl;
}
.lxm-header .lxm-h-wrap{max-width:1180px;margin:0 auto;padding:0 28px;}
.lxm-header .lxm-nav{display:flex;align-items:center;justify-content:space-between;padding:16px 0;}
.lxm-header .lxm-logo img{height:28px;width:auto;display:block;}
.lxm-header .lxm-links{display:flex;gap:26px;font-size:15px;font-weight:600;list-style:none;margin:0;padding:0;}
.lxm-header .lxm-links a{color:#4a3b30;text-decoration:none;position:relative;padding:4px 0;opacity:.85;white-space:nowrap;}
.lxm-header .lxm-links a:hover{opacity:1;}
.lxm-header .lxm-actions{display:flex;align-items:center;gap:14px;}
.lxm-header .lxm-icon{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#F3ECE3;color:#4a3b30;position:relative;}
.lxm-header .lxm-icon svg{width:17px;height:17px;}
.lxm-header .lxm-cart-count{position:absolute;top:-3px;left:-3px;background:#c17b7e;color:#fff;font-size:10px;font-weight:700;min-width:16px;height:16px;border-radius:50%;display:flex;align-items:center;justify-content:center;padding:0 3px;}
.lxm-header .lxm-burger{display:none;background:none;border:none;cursor:pointer;color:#4a3b30;padding:6px;}
.lxm-header .lxm-mobile-panel{
  display:none; flex-direction:column; gap:2px; padding:8px 0 18px;
  border-top:1px solid rgba(139,112,96,.12);
}
.lxm-header .lxm-mobile-panel a{
  display:block; padding:13px 4px; font-size:15.5px; font-weight:600; color:#4a3b30; text-decoration:none;
  border-bottom:1px solid rgba(139,112,96,.08);
}
.lxm-header.lxm-menu-open .lxm-mobile-panel{display:flex;}

/* products submenu — desktop */
.lxm-header .lxm-links li{position:relative;}
.lxm-header .lxm-menu-toggle{
  background:none;border:none;font:inherit;font-weight:600;color:#4a3b30;cursor:pointer;
  padding:4px 0;opacity:.85;display:inline-flex;align-items:center;gap:6px;
}
.lxm-header .lxm-menu-toggle:hover{opacity:1;}
.lxm-header .lxm-menu-toggle svg{width:12px;height:12px;transition:transform .2s ease;}
.lxm-header .lxm-sub{
  position:absolute; top:calc(100% + 12px); inset-inline-start:0; min-width:240px;
  background:#FBF8F4; border:1px solid rgba(139,112,96,.14); border-radius:16px;
  box-shadow:0 14px 36px rgba(107,86,70,.14); padding:8px; list-style:none; margin:0; display:none;
}
.lxm-header .lxm-links li.lxm-has-sub:hover .lxm-sub,
.lxm-header .lxm-links li.lxm-sub-open .lxm-sub{display:block;}
.lxm-header .lxm-links li.lxm-sub-open .lxm-menu-toggle svg{transform:rotate(180deg);}
.lxm-header .lxm-sub a{display:block;padding:10px 12px;border-radius:10px;font-size:14.5px;white-space:normal;opacity:.9;}
.lxm-header .lxm-sub a:hover{background:#F3ECE3;opacity:1;}

/* products submenu — inside the burger */
.lxm-header .lxm-m-toggle{
  display:flex;align-items:center;justify-content:space-between;width:100%;
  background:none;border:none;font:inherit;font-weight:600;font-size:15.5px;color:#4a3b30;
  padding:13px 4px;border-bottom:1px solid rgba(139,112,96,.08);cursor:pointer;text-align:start;
}
.lxm-header .lxm-m-toggle svg{width:14px;height:14px;transition:transform .2s ease;flex:none;}
.lxm-header .lxm-m-sub{display:none;}
.lxm-header .lxm-m-sub a{padding-inline-start:22px;font-size:14.5px;font-weight:500;opacity:.88;}
.lxm-header .lxm-m-group.lxm-sub-open .lxm-m-sub{display:block;}
.lxm-header .lxm-m-group.lxm-sub-open .lxm-m-toggle svg{transform:rotate(180deg);}

@media(max-width:940px){
  .lxm-header .lxm-links{display:none;}
  .lxm-header .lxm-burger{display:flex;}
}
@media(min-width:941px){
  .lxm-header .lxm-mobile-panel{display:none !important;}
}

.lxm-cart-drawer-overlay{position:fixed;inset:0;background:rgba(58,47,40,.4);opacity:0;pointer-events:none;transition:opacity .3s ease;z-index:200;}
.lxm-cart-drawer-overlay.lxm-open{opacity:1;pointer-events:auto;}
/* Physical right/left on purpose: inset-inline-end resolves to the LEFT edge under dir=rtl,
   which combined with translateX(+100%) parked the panel mid-screen instead of off-screen. */
.lxm-cart-drawer{
  position:fixed; top:0; right:0; left:auto; height:100%; width:100%; max-width:420px;
  background:#FAF6F1; z-index:201; display:flex; flex-direction:column;
  transform:translateX(calc(100% + 24px)); transition:transform .35s ease, visibility .35s ease;
  font-family:'Assistant',sans-serif; direction:rtl;
  pointer-events:none; visibility:hidden;
}
.lxm-cart-drawer.lxm-open{transform:translateX(0); pointer-events:auto; visibility:visible; box-shadow:-10px 0 40px rgba(0,0,0,.15);}
.lxm-cart-drawer-head{display:flex;align-items:center;justify-content:space-between;padding:20px 24px;border-bottom:1px solid rgba(139,112,96,.15);}
.lxm-cart-drawer-head h3{font-family:'Frank Ruhl',serif;font-size:19px;color:#4a3b30;margin:0;}
.lxm-cart-drawer-close{background:none;border:none;cursor:pointer;color:#4a3b30;padding:8px;position:relative;z-index:5;}
.lxm-cart-drawer-close svg{pointer-events:none;}
.lxm-cart-drawer-body{flex:1;overflow-y:auto;padding:20px 24px;display:flex;flex-direction:column;gap:18px;}
.lxm-cart-line{display:flex;gap:14px;}
.lxm-cart-line img{width:76px;height:76px;border-radius:14px;object-fit:cover;background:#F3ECE3;flex:none;}
.lxm-cart-line-info{flex:1;display:flex;flex-direction:column;gap:6px;}
.lxm-cart-line-title{font-size:14.5px;font-weight:600;color:#4a3b30;}
.lxm-cart-line-variant{font-size:12.5px;opacity:.65;}
.lxm-cart-line-qty{display:flex;align-items:center;gap:10px;margin-top:4px;}
.lxm-cart-line-qty button{width:26px;height:26px;border-radius:50%;border:1px solid rgba(139,112,96,.3);background:none;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#4a3b30;font-size:15px;line-height:1;}
.lxm-cart-line-qty span{min-width:16px;text-align:center;font-size:14px;}
.lxm-cart-line-price{font-family:'Frank Ruhl',serif;font-weight:700;color:#6b5646;white-space:nowrap;direction:ltr;unicode-bidi:isolate;}
.lxm-cart-line-remove{font-size:12px;opacity:.5;text-decoration:underline;cursor:pointer;background:none;border:none;padding:0;margin-top:2px;color:#4a3b30;align-self:flex-start;}
.lxm-cart-empty{text-align:center;padding:60px 20px;opacity:.6;font-size:15px;}
.lxm-cart-drawer-foot{padding:20px 24px 26px;border-top:1px solid rgba(139,112,96,.15);}
.lxm-cart-saving-row{display:flex;justify-content:space-between;align-items:center;font-size:13.5px;font-weight:700;color:#8a4a4d;background:#f1dcdb;border-radius:12px;padding:10px 14px;margin-bottom:12px;}
.lxm-cart-saving-amount{direction:ltr;unicode-bidi:isolate;}
.lxm-cart-subtotal-row{display:flex;justify-content:space-between;align-items:center;font-size:15px;font-weight:600;color:#4a3b30;margin-bottom:14px;}
.lxm-cart-subtotal-amount{font-family:'Frank Ruhl',serif;font-size:19px;direction:ltr;unicode-bidi:isolate;}
.lxm-cart-checkout-btn{display:block;width:100%;text-align:center;padding:16px;border-radius:999px;background:#8B7060;color:#fff;font-weight:700;font-size:16px;text-decoration:none;box-sizing:border-box;}
.lxm-cart-checkout-btn:hover{background:#6b5646;}

.lxm-cart-upsell{border-top:1px solid rgba(139,112,96,.15);padding-top:18px;margin-top:4px;}
.lxm-cart-nudge{background:#f1dcdb;color:#8a4a4d;border-radius:12px;padding:10px 14px;text-align:center;font-size:13px;font-weight:700;margin-bottom:14px;line-height:1.5;}
.lxm-cart-upsell-title{font-size:13px;font-weight:700;color:var(--taupe-dark,#6b5646);margin-bottom:12px;}
.lxm-cart-upsell-item{display:flex;align-items:center;gap:12px;padding:8px 0;}
.lxm-cart-upsell-item img{width:52px;height:52px;border-radius:10px;object-fit:cover;background:#F3ECE3;flex:none;}
.lxm-cart-upsell-info{flex:1;display:flex;flex-direction:column;gap:2px;min-width:0;}
.lxm-cart-upsell-info span.lxm-cart-upsell-name{font-size:13.5px;font-weight:600;color:#4a3b30;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.lxm-cart-upsell-info span.lxm-cart-upsell-price{font-size:12.5px;opacity:.65;direction:ltr;unicode-bidi:isolate;display:block;}
.lxm-cart-upsell-add{flex:none;background:none;border:1.5px solid #8B7060;color:#8B7060;border-radius:999px;padding:6px 16px;font-size:12.5px;font-weight:700;cursor:pointer;white-space:nowrap;}
.lxm-cart-upsell-add:hover{background:#8B7060;color:#fff;}
.lxm-cart-upsell-add[disabled]{opacity:.5;cursor:default;}
</style>

{%- liquid
  assign nav_bag = all_products['תיק-חיתולים-3-ב-1-luxamom']
  assign nav_sling = all_products['מנשא-חיבוק-luxamom']
  assign nav_warmer = all_products['מחמם-בקבוק-usb-נייד-luxamom']
  assign nav_cushion = all_products['כרית-מגן-ראש-לפעוט-luxamom']
-%}

<header class="lxm-header">
  <div class="lxm-h-wrap lxm-nav">
    <button class="lxm-burger" type="button" aria-label="{{ 'accessibility.menu' | t }}">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    <a href="{{ routes.root_url }}" class="lxm-logo">
      <img src="{{ 'luxamom-logo.png' | asset_url }}" alt="{{ shop.name | default: 'LUXAMOM' }}">
    </a>
    <ul class="lxm-links">
      <li><a href="{{ routes.root_url }}">בית</a></li>
      {%- comment -%}
        "מוצרים" opens the list instead of scrolling to an anchor: a shopper who
        already knows which product she wants shouldn't have to land on the home
        page and hunt for it.
      {%- endcomment -%}
      <li class="lxm-has-sub">
        <button type="button" class="lxm-menu-toggle" data-sub-toggle aria-expanded="false">
          מוצרים
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <ul class="lxm-sub">
          {% if nav_bag %}<li><a href="{{ nav_bag.url }}">{{ nav_bag.title | remove: ' LUXAMOM' }}</a></li>{% endif %}
          {% if nav_sling %}<li><a href="{{ nav_sling.url }}">{{ nav_sling.title | remove: ' LUXAMOM' }}</a></li>{% endif %}
          {% if nav_warmer %}<li><a href="{{ nav_warmer.url }}">{{ nav_warmer.title | remove: ' LUXAMOM' }}</a></li>{% endif %}
          {% if nav_cushion %}<li><a href="{{ nav_cushion.url }}">{{ nav_cushion.title | remove: ' LUXAMOM' }}</a></li>{% endif %}
        </ul>
      </li>
      {% if pages['about-luxa'] %}<li><a href="{{ pages['about-luxa'].url }}">אודות</a></li>{% endif %}
      {% if pages['משלוחים-והחזרות'] %}<li><a href="{{ pages['משלוחים-והחזרות'].url }}">משלוחים והחזרות</a></li>{% endif %}
      {% if pages['contact'] %}<li><a href="{{ pages['contact'].url }}">צור קשר</a></li>{% endif %}
    </ul>
    <div class="lxm-actions">
      <a href="{{ routes.search_url }}" class="lxm-icon" aria-label="{{ 'general.search.title' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </a>
      <a href="{{ routes.cart_url }}" class="lxm-icon" aria-label="{{ 'sections.cart.title' | t }}" data-cart-toggle>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <span class="lxm-cart-count" data-cart-count style="display:{% if cart.item_count > 0 %}flex{% else %}none{% endif %};">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
  <nav class="lxm-mobile-panel">
    <a href="{{ routes.root_url }}">בית</a>
    <div class="lxm-m-group">
      <button type="button" class="lxm-m-toggle" data-m-sub-toggle aria-expanded="false">
        מוצרים
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="lxm-m-sub">
        {% if nav_bag %}<a href="{{ nav_bag.url }}">{{ nav_bag.title | remove: ' LUXAMOM' }}</a>{% endif %}
        {% if nav_sling %}<a href="{{ nav_sling.url }}">{{ nav_sling.title | remove: ' LUXAMOM' }}</a>{% endif %}
        {% if nav_warmer %}<a href="{{ nav_warmer.url }}">{{ nav_warmer.title | remove: ' LUXAMOM' }}</a>{% endif %}
        {% if nav_cushion %}<a href="{{ nav_cushion.url }}">{{ nav_cushion.title | remove: ' LUXAMOM' }}</a>{% endif %}
      </div>
    </div>
    {% if pages['about-luxa'] %}<a href="{{ pages['about-luxa'].url }}">אודות</a>{% endif %}
    {% if pages['משלוחים-והחזרות'] %}<a href="{{ pages['משלוחים-והחזרות'].url }}">משלוחים והחזרות</a>{% endif %}
    {% if pages['contact'] %}<a href="{{ pages['contact'].url }}">צור קשר</a>{% endif %}
  </nav>
</header>

<div class="lxm-cart-drawer-overlay" data-cart-overlay></div>
<aside class="lxm-cart-drawer" data-cart-drawer aria-hidden="true">
  <div class="lxm-cart-drawer-head">
    <h3>הסל שלך</h3>
    <button type="button" class="lxm-cart-drawer-close" data-cart-close aria-label="סגירה">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div class="lxm-cart-drawer-body" data-cart-body>
    <p class="lxm-cart-empty">הסל שלך ריק</p>
  </div>
  <div class="lxm-cart-drawer-foot" data-cart-foot style="display:none;">
    <div class="lxm-cart-upsell" data-cart-upsell>
      <p class="lxm-cart-nudge" data-cart-nudge style="display:none;"></p>
      <p class="lxm-cart-upsell-title">להשלים את הסט</p>
      {% for n in (1..4) %}
        {% case n %}
          {% when 1 %}{% assign lxm_up = nav_bag %}
          {% when 2 %}{% assign lxm_up = nav_sling %}
          {% when 3 %}{% assign lxm_up = nav_warmer %}
          {% when 4 %}{% assign lxm_up = nav_cushion %}
        {% endcase %}
        {% if lxm_up %}
          {% assign lxm_up_variant = lxm_up.selected_or_first_available_variant %}
          <div class="lxm-cart-upsell-item" data-upsell-product="{{ lxm_up.id }}" data-upsell-variant="{{ lxm_up_variant.id }}" data-upsell-price="{{ lxm_up_variant.price }}">
            <img src="{{ lxm_up.featured_image | image_url: width: 120 }}" alt="{{ lxm_up.title }}">
            <div class="lxm-cart-upsell-info">
              <span class="lxm-cart-upsell-name">{{ lxm_up.title }}</span>
              <span class="lxm-cart-upsell-price">{{ lxm_up_variant.price | money_without_trailing_zeros }}</span>
            </div>
            <button type="button" class="lxm-cart-upsell-add" data-upsell-add>הוספה</button>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div class="lxm-cart-saving-row" data-cart-saving style="display:none;">
      <span>חסכת בבאנדל</span>
      <span class="lxm-cart-saving-amount" data-cart-saving-amount>₪0</span>
    </div>
    <div class="lxm-cart-subtotal-row">
      <span>סכום ביניים</span>
      <span class="lxm-cart-subtotal-amount" data-cart-subtotal>₪0</span>
    </div>
    <a href="{{ routes.cart_url }}" class="lxm-cart-checkout-btn" data-cart-checkout>מעבר לתשלום</a>
  </div>
</aside>

<script>
(function(){
  var header = document.currentScript.previousElementSibling;
  if (!header || !header.classList.contains('lxm-header')) { header = document.querySelector('.lxm-header'); }
  if (!header) return;
  var burger = header.querySelector('.lxm-burger');
  if (burger) {
    burger.addEventListener('click', function(){
      header.classList.toggle('lxm-menu-open');
    });
    header.querySelectorAll('.lxm-mobile-panel a').forEach(function(a){
      a.addEventListener('click', function(){ header.classList.remove('lxm-menu-open'); });
    });
  }

  // products submenu, both breakpoints
  header.querySelectorAll('[data-sub-toggle],[data-m-sub-toggle]').forEach(function(btn){
    var group = btn.parentElement;
    btn.addEventListener('click', function(e){
      e.stopPropagation();
      var open = group.classList.toggle('lxm-sub-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  });
  document.addEventListener('click', function(e){
    header.querySelectorAll('.lxm-sub-open').forEach(function(group){
      if (group.contains(e.target)) return;
      group.classList.remove('lxm-sub-open');
      var btn = group.querySelector('[data-sub-toggle],[data-m-sub-toggle]');
      if (btn) btn.setAttribute('aria-expanded', 'false');
    });
  });

  // cart drawer
  var drawer = document.querySelector('[data-cart-drawer]');
  var overlay = document.querySelector('[data-cart-overlay]');
  var body = document.querySelector('[data-cart-body]');
  var foot = document.querySelector('[data-cart-foot]');
  var subtotalEl = document.querySelector('[data-cart-subtotal]');
  var savingEl = document.querySelector('[data-cart-saving]');
  var savingAmountEl = document.querySelector('[data-cart-saving-amount]');
  var upsellWrap = document.querySelector('[data-cart-upsell]');
  var cartToggles = document.querySelectorAll('[data-cart-toggle]');

  // Not every price is a round number any more, so the agorot have to survive
  // into the subtotal and the saving row.
  function money(cents){
    var value = Math.round(cents) / 100;
    var fraction = Math.round(value * 100) % 100 === 0 ? 0 : 2;
    return '₪' + value.toLocaleString('he-IL', { minimumFractionDigits: fraction, maximumFractionDigits: 2 });
  }

  // Same tiers as the automatic discounts, indexed by how many items are in the
  // cart: 2 → 10%, 3 → 15%, 4 → 20%.
  var BUNDLE_RATES = [0, 0, 0.10, 0.15, 0.20];
  function rateFor(count){
    if (count < 0) return 0;
    return BUNDLE_RATES[Math.min(count, BUNDLE_RATES.length - 1)] || 0;
  }

  function updateUpsells(cart){
    if (!upsellWrap) return;
    var cartProductIds = (cart && cart.items ? cart.items : []).map(function(i){ return String(i.product_id); });
    upsellWrap.querySelectorAll('[data-upsell-product]').forEach(function(item){
      var pid = item.getAttribute('data-upsell-product').replace(/\D/g, '');
      var inCart = cartProductIds.some(function(cid){ return cid === pid; });
      item.style.display = inCart ? 'none' : 'flex';
    });
    var visible = Array.prototype.filter.call(upsellWrap.querySelectorAll('[data-upsell-product]'), function(item){
      return item.style.display !== 'none';
    });
    upsellWrap.style.display = visible.length ? 'block' : 'none';
    updateNudge(cart, visible);
  }

  function upPrice(item){ return parseInt(item.getAttribute('data-upsell-price'), 10) || 0; }
  function upName(item){ return item.querySelector('.lxm-cart-upsell-name').textContent.trim(); }

  // Tells the shopper what the next item is actually worth to her, in shekels.
  function updateNudge(cart, visible){
    var nudge = document.querySelector('[data-cart-nudge]');
    if (!nudge) return;
    var count = (cart && cart.item_count) || 0;
    var base = (cart && cart.original_total_price) || 0;
    var rate = rateFor(count);
    var nextRate = rateFor(count + 1);
    if (count < 1 || !visible.length || nextRate <= rate) { nudge.style.display = 'none'; return; }
    var pick = visible.slice().sort(function(a, b){ return upPrice(a) - upPrice(b); })[0];
    var extra = Math.round((base + upPrice(pick)) * nextRate) - Math.round(base * rate);
    nudge.textContent = 'הוסיפי ' + upName(pick) + ' וקבלי ' + Math.round(nextRate * 100) + '% הנחה — עוד ' + money(extra) + ' חיסכון';
    nudge.style.display = 'block';
  }

  function renderCart(cart){
    var countEls = document.querySelectorAll('[data-cart-count]');
    if (!cart || !cart.items || !cart.items.length) {
      body.innerHTML = '<p class="lxm-cart-empty">הסל שלך ריק</p>';
      if (foot) foot.style.display = 'none';
    } else {
      body.innerHTML = cart.items.map(function(item){
        return '<div class="lxm-cart-line" data-line-key="' + item.key + '">' +
          '<img src="' + (item.image || '') + '" alt="">' +
          '<div class="lxm-cart-line-info">' +
            '<span class="lxm-cart-line-title">' + item.product_title + '</span>' +
            (item.variant_title && item.variant_title !== 'Default Title' ? '<span class="lxm-cart-line-variant">' + item.variant_title + '</span>' : '') +
            '<div class="lxm-cart-line-qty">' +
              '<button type="button" data-qty-decrease>−</button>' +
              '<span>' + item.quantity + '</span>' +
              '<button type="button" data-qty-increase>+</button>' +
            '</div>' +
            '<button type="button" class="lxm-cart-line-remove" data-line-remove>הסרה</button>' +
          '</div>' +
          '<span class="lxm-cart-line-price">' + money(item.final_line_price) + '</span>' +
        '</div>';
      }).join('');
      if (foot) foot.style.display = 'block';
      if (subtotalEl) subtotalEl.textContent = money(cart.total_price);

      // Automatic bundle discounts land in total_discount; surface them so the
      // saving is visible before checkout, not just at it.
      var saved = cart.total_discount || 0;
      if (savingEl) {
        savingEl.style.display = saved > 0 ? 'flex' : 'none';
        if (saved > 0 && savingAmountEl) savingAmountEl.textContent = money(saved);
      }

      body.querySelectorAll('[data-qty-increase]').forEach(function(btn){
        btn.addEventListener('click', function(){
          var line = btn.closest('[data-line-key]');
          var key = line.getAttribute('data-line-key');
          var qtySpan = btn.previousElementSibling;
          changeLine(key, parseInt(qtySpan.textContent, 10) + 1);
        });
      });
      body.querySelectorAll('[data-qty-decrease]').forEach(function(btn){
        btn.addEventListener('click', function(){
          var line = btn.closest('[data-line-key]');
          var key = line.getAttribute('data-line-key');
          var qtySpan = btn.nextElementSibling;
          changeLine(key, parseInt(qtySpan.textContent, 10) - 1);
        });
      });
      body.querySelectorAll('[data-line-remove]').forEach(function(btn){
        btn.addEventListener('click', function(){
          var line = btn.closest('[data-line-key]');
          changeLine(line.getAttribute('data-line-key'), 0);
        });
      });
    }
    countEls.forEach(function(el){
      el.textContent = cart.item_count;
      el.style.display = cart.item_count > 0 ? 'flex' : 'none';
    });
    updateUpsells(cart);
  }

  function fetchCart(){
    return fetch('/cart.js').then(function(r){ return r.json(); });
  }

  function changeLine(key, qty){
    fetch('/cart/change.js', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ id: key, quantity: qty })
    }).then(function(r){ return r.json(); }).then(renderCart);
  }

  function openDrawer(){
    if (!drawer) return;
    drawer.classList.add('lxm-open');
    if (overlay) overlay.classList.add('lxm-open');
    drawer.setAttribute('aria-hidden', 'false');
  }
  function closeDrawer(){
    if (!drawer) return;
    drawer.classList.remove('lxm-open');
    if (overlay) overlay.classList.remove('lxm-open');
    drawer.setAttribute('aria-hidden', 'true');
  }

  cartToggles.forEach(function(a){
    a.addEventListener('click', function(e){
      e.preventDefault();
      fetchCart().then(function(cart){ renderCart(cart); openDrawer(); });
    });
  });

  if (upsellWrap) {
    upsellWrap.querySelectorAll('[data-upsell-add]').forEach(function(btn){
      btn.addEventListener('click', function(){
        var item = btn.closest('[data-upsell-product]');
        var variantId = item.getAttribute('data-upsell-variant');
        if (!variantId) return;
        btn.disabled = true;
        btn.textContent = '...';
        window.LXMCart.addItem(variantId, 1).then(function(){
          btn.disabled = false;
          btn.textContent = 'הוספה';
        }).catch(function(){
          btn.disabled = false;
          btn.textContent = 'הוספה';
        });
      });
    });
  }

  // Robust close handling: event delegation on document, so it doesn't depend on
  // the exact element reference captured at script-load time, plus Escape key.
  document.addEventListener('click', function(e){
    if (e.target.closest('[data-cart-close]') || e.target === overlay || e.target.closest('[data-cart-overlay]')) {
      closeDrawer();
    }
  });
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape' && drawer && drawer.classList.contains('lxm-open')) {
      closeDrawer();
    }
  });

  window.LXMCart = {
    open: function(){ fetchCart().then(function(cart){ renderCart(cart); openDrawer(); }); },
    close: closeDrawer,
    addItem: function(variantId, qty){
      qty = qty || 1;
      return fetch('/cart/add.js', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ items: [{ id: variantId, quantity: qty }] })
      }).then(function(r){ return r.json(); }).then(function(){
        return fetchCart();
      }).then(function(cart){
        renderCart(cart);
        openDrawer();
        return cart;
      });
    }
  };

  fetchCart().then(function(cart){
    document.querySelectorAll('[data-cart-count]').forEach(function(el){
      el.textContent = cart.item_count;
      el.style.display = cart.item_count > 0 ? 'flex' : 'none';
    });
    updateUpsells(cart);
  });
})();
</script>

