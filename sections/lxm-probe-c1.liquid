<script>
(function(){
  var root = document.currentScript.previousElementSibling;
  if (!root || !root.classList.contains('lxm-pdp')) { root = document.querySelector('.lxm-pdp'); }
  if (!root) return;

  var variants = [];
  var dataEl = root.querySelector('[data-lxm-variants]');
  try { variants = JSON.parse(dataEl.textContent); } catch (e) { return; }
  if (!variants.length) return;

  var mainImgs = root.querySelectorAll('.lxm-gallery-img');
  var thumbs = root.querySelectorAll('.lxm-thumb');
  // Scoped to [data-color]: the second unit's swatches carry the same class, and
  // an unscoped selector would fire both handlers on one click.
  var swatches = root.querySelectorAll('.lxm-swatch[data-color]');
  var qtyCards = root.querySelectorAll('.lxm-qty-card');
  var variantInput = root.querySelector('[data-variant-id-input]');
  var priceNow = root.querySelector('[data-price]');
  var priceInline = root.querySelector('[data-price-inline]');
  var selectedNameEl = root.querySelector('[data-selected-color-name]');
  var stickyPrice = root.querySelector('[data-sticky-price]');
  var priceRow = root.querySelector('.lxm-price-row');
  var addBtn = root.querySelector('[data-add-btn]');

  var secondColorWrap = root.querySelector('[data-second-color]');
  var swatches2 = root.querySelectorAll('[data-color2]');
  var colorLabel = root.querySelector('[data-color-label]');
  var selectedName2El = root.querySelector('[data-selected-color2-name]');
  var addLabel = root.querySelector('[data-add-label]');
  var stickyCta = root.querySelector('[data-sticky-cta]');
  var stockWrap = root.querySelector('[data-stock]');
  var stockText = root.querySelector('[data-stock-text]');
  var pairDiscount = Math.round(parseFloat(root.getAttribute('data-pair-discount') || '0') * 100);
  var ctaSingle = root.getAttribute('data-cta-single') || 'אני רוצה אחד';
  var ctaPair = root.getAttribute('data-cta-pair') || 'אני רוצה שניים';
  var stockCountText = root.getAttribute('data-stock-count-text') || 'נשארו רק {count} יחידות';
  var stockNote = root.getAttribute('data-stock-note') || '';
  var stockThreshold = parseInt(root.getAttribute('data-stock-threshold'), 10) || 0;

  var state = { color: variants[0].color, color2: variants[0].color, qty: 1 };
  var activeSwatch = root.querySelector('.lxm-swatch[data-color].lxm-swatch-active');
  if (activeSwatch) {
    state.color = activeSwatch.getAttribute('data-color');
    state.color2 = state.color;
  }

  function findVariant(color) {
    for (var i = 0; i < variants.length; i++) {
      if (variants[i].color === color) return variants[i];
    }
    return null;
  }

  function money(cents) {
    var value = Math.round(cents) / 100;
    var fraction = Math.round(value * 100) % 100 === 0 ? 0 : 2;
    return '₪' + value.toLocaleString('he-IL', { minimumFractionDigits: fraction, maximumFractionDigits: 2 });
  }

  // Two units are priced by the automatic "2 for" discount in the admin rather
  // than by a variant, so the page derives the pair price from the same amount
  // the cart will actually take off — change the discount and the page follows.
  function priceFor(qty) {
    var v = findVariant(state.color);
    if (!v) return 0;
    return qty === 2 ? (v.price * 2) - pairDiscount : v.price;
  }

  function compareFor(qty) {
    var v = findVariant(state.color);
    if (!v || !v.compare) return 0;
    return qty === 2 ? v.compare * 2 : v.compare;
  }

  function showImage(src) {
    if (!src) return;
    var matched = false;
    mainImgs.forEach(function (img) {
      var isMatch = img.getAttribute('data-media-src') === src;
      img.classList.toggle('lxm-active', isMatch);
      if (isMatch) matched = true;
    });
    if (!matched && mainImgs[0]) mainImgs[0].classList.add('lxm-active');
    thumbs.forEach(function (t, i) {
      t.classList.toggle('lxm-thumb-active', mainImgs[i] && mainImgs[i].classList.contains('lxm-active'));
    });
  }

  // The count is per colour, and it is only ever the real one: with inventory
  // tracking on it reads the remaining units for the selected colour and stays
  // hidden above the threshold; with tracking off it falls back to wording that
  // makes no numeric claim, so the page never invents a number.
  function renderStock(v) {
    if (!stockWrap || !stockText) return;
    if (v.tracked && v.inv > 0) {
      if (stockThreshold && v.inv > stockThreshold) {
        stockWrap.hidden = true;
        return;
      }
      stockText.textContent = stockCountText.replace('{count}', v.inv);
      stockWrap.hidden = false;
      return;
    }
    if (!v.tracked && stockNote) {
      stockText.textContent = stockNote;
      stockWrap.hidden = false;
      return;
    }
    stockWrap.hidden = true;
  }

  // Both quantity cards always price the currently selected colour, so the
  // shopper compares one unit against the pair without switching anything.
  function renderQtyCards() {
    qtyCards.forEach(function (card) {
      var qty = parseInt(card.getAttribute('data-qty'), 10);
      var priceEl = card.querySelector('[data-qty-price]');
      var subEl = card.querySelector('[data-qty-sub]');
      if (priceEl) priceEl.textContent = money(priceFor(qty));
      if (subEl) {
        if (qty === 2) {
          subEl.textContent = 'חוסכים ' + money(pairDiscount);
        } else if (compareFor(1) > priceFor(1)) {
          subEl.textContent = 'במקום ' + money(compareFor(1));
        } else {
          subEl.textContent = '';
        }
      }
      var isActive = qty === state.qty;
      card.classList.toggle('lxm-qty-active', isActive);
      card.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });
  }

  function render() {
    var v = findVariant(state.color);
    if (!v) return;
    var price = priceFor(state.qty);
    var compare = compareFor(state.qty);
    var priceStr = money(price);

    if (variantInput) variantInput.value = v.id;
    if (priceNow) priceNow.textContent = priceStr;
    if (priceInline) priceInline.textContent = priceStr;
    if (stickyPrice) stickyPrice.textContent = priceStr;
    if (selectedNameEl) selectedNameEl.textContent = v.color;
    if (colorLabel) colorLabel.textContent = state.qty === 2 ? 'צבע היחידה הראשונה' : 'צבע';
    if (selectedName2El) selectedName2El.textContent = state.color2;
    if (secondColorWrap) secondColorWrap.hidden = state.qty !== 2;

    var wasEl = priceRow.querySelector('[data-compare-price]');
    var offEl = priceRow.querySelector('[data-price-off]');
    if (compare > price) {
      if (!wasEl) {
        wasEl = document.createElement('span');
        wasEl.className = 'lxm-price-was';
        wasEl.setAttribute('data-compare-price', '');
        priceRow.appendChild(wasEl);
      }
      wasEl.textContent = money(compare);
      if (!offEl) {
        offEl = document.createElement('span');
        offEl.className = 'lxm-price-off';
        offEl.setAttribute('data-price-off', '');
        priceRow.appendChild(offEl);
      }
      offEl.textContent = Math.round((compare - price) * 100 / compare) + '% הנחה';
    } else {
      if (wasEl) wasEl.remove();
      if (offEl) offEl.remove();
    }

    // The label is a separate element so that going out of stock and back
    // doesn't destroy the price span living inside the same button.
    var soldOut = !v.available;
    var cta = state.qty === 2 ? ctaPair : ctaSingle;
    if (addBtn) addBtn.disabled = soldOut;
    if (addLabel) addLabel.textContent = soldOut ? 'אזל מהמלאי' : cta;
    if (stickyCta) stickyCta.textContent = soldOut ? 'אזל מהמלאי' : cta;
    if (priceInline) priceInline.style.display = soldOut ? 'none' : '';

    renderStock(v);

    swatches.forEach(function (s) {
      var isActive = s.getAttribute('data-color') === state.color;
      s.classList.toggle('lxm-swatch-active', isActive);
      s.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });
    swatches2.forEach(function (s) {
      var isActive = s.getAttribute('data-color2') === state.color2;
      s.classList.toggle('lxm-swatch-active', isActive);
      s.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });

    renderQtyCards();
    showImage(v.img);
  }

  swatches.forEach(function (swatch) {
    swatch.addEventListener('click', function () {
      state.color = swatch.getAttribute('data-color');
      // While a single unit is selected the second colour has no meaning yet,
      // so it follows along — picking the pair then defaults to a matching set.
      if (state.qty !== 2) state.color2 = state.color;
      render();
    });
  });

  swatches2.forEach(function (swatch) {
    swatch.addEventListener('click', function () {
      state.color2 = swatch.getAttribute('data-color2');
      render();
    });
  });

  qtyCards.forEach(function (card) {
    card.addEventListener('click', function () {
      state.qty = parseInt(card.getAttribute('data-qty'), 10);
      render();
    });
  });

  // gallery thumbs
  thumbs.forEach(function (thumb) {
    thumb.addEventListener('click', function () {
      var idx = thumb.getAttribute('data-thumb-index');
      mainImgs.forEach(function (img) {
        img.classList.toggle('lxm-active', img.getAttribute('data-gallery-index') === idx);
      });
      thumbs.forEach(function (t) { t.classList.toggle('lxm-thumb-active', t === thumb); });
    });
  });

  // A pair can be two different colours, which is two cart lines — more than a
  // single variant id can express, so the add goes through the cart API. If
  // scripting fails entirely the form still posts natively and adds one unit.
  function addToCart() {
    var v1 = findVariant(state.color);
    if (!v1) return Promise.resolve();
    var items = [{ id: v1.id, quantity: 1 }];
    if (state.qty === 2) {
      var v2 = findVariant(state.color2);
      if (!v2 || v2.id === v1.id) items[0].quantity = 2;
      else items.push({ id: v2.id, quantity: 1 });
    }
    return fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: items })
    }).then(function (r) {
      return r.json();
    }).then(function () {
      if (window.LXMCart && window.LXMCart.open) window.LXMCart.open();
      else window.location.href = '/cart';
    });
  }

  var pdpForm = root.querySelector('.lxm-pdp-form');
  if (pdpForm) {
    pdpForm.addEventListener('submit', function (e) {
      e.preventDefault();
      if (addBtn) addBtn.disabled = true;
      addToCart().then(function () {
        if (addBtn) addBtn.disabled = false;
      }).catch(function () {
        if (addBtn) addBtn.disabled = false;
      });
    });
  }

  // accordion
  root.querySelectorAll('.lxm-accordion').forEach(function (group) {
    var items = group.querySelectorAll('.lxm-acc-item');
    items.forEach(function (item) {
      var head = item.querySelector('.lxm-acc-head');
      head.addEventListener('click', function () {
        var isOpen = item.classList.contains('lxm-acc-open');
        items.forEach(function (i) { i.classList.remove('lxm-acc-open'); });
        if (!isOpen) item.classList.add('lxm-acc-open');
      });
    });
  });

  // sticky mobile add-to-cart bar
  var stickyBar = root.querySelector('[data-sticky-bar]');
  var mainCta = root.querySelector('.lxm-cta .lxm-btn-primary');
  if (stickyBar && mainCta) {
    var toggleSticky = function () {
      var r = mainCta.getBoundingClientRect();
      stickyBar.classList.toggle('lxm-sticky-visible', r.bottom < 0);
    };
    toggleSticky();
    window.addEventListener('scroll', toggleSticky, { passive: true });
    window.addEventListener('resize', toggleSticky);
    var stickyCta = stickyBar.querySelector('[data-sticky-cta]');
    if (stickyCta) {
      stickyCta.addEventListener('click', function () {
        mainCta.click();
        mainCta.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    }
  }

  render();
})();
</script>

