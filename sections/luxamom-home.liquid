<style>
@font-face{font-family:'Frank Ruhl';font-weight:400;font-style:normal;font-display:swap;src:url({{ 'frl-400-he.woff2' | asset_url }}) format('woff2');unicode-range:U+0307-0308,U+0590-05FF,U+200C-2010,U+20AA,U+25CC,U+FB1D-FB4F;}
@font-face{font-family:'Frank Ruhl';font-weight:400;font-style:normal;font-display:swap;src:url({{ 'frl-400-lat.woff2' | asset_url }}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+2000-206F,U+2122;}
@font-face{font-family:'Frank Ruhl';font-weight:700;font-style:normal;font-display:swap;src:url({{ 'frl-700-he.woff2' | asset_url }}) format('woff2');unicode-range:U+0307-0308,U+0590-05FF,U+200C-2010,U+20AA,U+25CC,U+FB1D-FB4F;}
@font-face{font-family:'Frank Ruhl';font-weight:700;font-style:normal;font-display:swap;src:url({{ 'frl-700-lat.woff2' | asset_url }}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+2000-206F,U+2122;}
@font-face{font-family:'Assistant';font-weight:400;font-style:normal;font-display:swap;src:url({{ 'assist-400-he.woff2' | asset_url }}) format('woff2');unicode-range:U+0307-0308,U+0590-05FF,U+200C-2010,U+20AA,U+25CC,U+FB1D-FB4F;}
@font-face{font-family:'Assistant';font-weight:400;font-style:normal;font-display:swap;src:url({{ 'assist-400-lat.woff2' | asset_url }}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+2000-206F,U+2122;}
@font-face{font-family:'Assistant';font-weight:600;font-style:normal;font-display:swap;src:url({{ 'assist-600-he.woff2' | asset_url }}) format('woff2');unicode-range:U+0307-0308,U+0590-05FF,U+200C-2010,U+20AA,U+25CC,U+FB1D-FB4F;}
@font-face{font-family:'Assistant';font-weight:600;font-style:normal;font-display:swap;src:url({{ 'assist-600-lat.woff2' | asset_url }}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+2000-206F,U+2122;}

:root{
  --cream:#FAF6F1;
  --cream-2:#F3ECE3;
  --taupe:#8B7060;
  --taupe-dark:#6b5646;
  --rose:#D9989A;
  --rose-dark:#c17b7e;
  --rose-soft:#f1dcdb;
  --sage:#A8B8A0;
  --ink:#3a2f28;
  --white:#FBF8F4;
  --shadow: 0 14px 36px rgba(107,86,70,0.10);
}
*{box-sizing:border-box;}
.lxm-home h1,.lxm-home h2,.lxm-home h3,.lxm-home .serif{font-family:'Frank Ruhl',serif; font-weight:700; margin:0;}
.lxm-home{background:var(--cream); color:var(--ink); font-family:'Assistant',sans-serif; direction:rtl; overflow-x:hidden; line-height:1.6;}
.lxm-home p{margin:0;}
.lxm-home a{text-decoration:none;color:inherit;}
.lxm-home img{max-width:100%;display:block;}
.lxm-wrap{max-width:1180px;margin:0 auto;padding:0 28px;}
.lxm-home .lxm-btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  padding:15px 34px;border-radius:999px;font-family:'Assistant',sans-serif;
  font-weight:600;font-size:15.5px;cursor:pointer;border:1.5px solid transparent;
  transition:transform .25s ease, box-shadow .25s ease, background .25s ease, color .25s ease;
  white-space:nowrap;
}
.lxm-home .lxm-btn-primary{background:var(--taupe);color:var(--white);}
.lxm-home .lxm-btn-primary:hover{background:var(--taupe-dark); transform:translateY(-2px); box-shadow:var(--shadow);}
.lxm-home .lxm-btn-outline{background:transparent;border-color:var(--taupe);color:var(--taupe);}
.lxm-home .lxm-btn-outline:hover{background:var(--taupe);color:var(--white); transform:translateY(-2px);}
.lxm-home .lxm-eyebrow{
  font-size:13px; letter-spacing:.14em; font-weight:600; color:var(--rose-dark);
  text-transform:uppercase; display:flex; align-items:center; gap:10px; justify-content:center;
}
.lxm-home .lxm-eyebrow::before,.lxm-home .lxm-eyebrow::after{content:'';width:26px;height:1px;background:var(--rose);}
.lxm-home .lxm-section{padding:100px 0;}
.lxm-home .lxm-section-head{text-align:center;max-width:640px;margin:0 auto 56px;}
.lxm-home .lxm-section-head h2{font-size:clamp(28px,4vw,40px); margin-top:14px; color:var(--taupe-dark);}
.lxm-home .lxm-section-head p{margin-top:16px;font-size:17px;opacity:.82;}

.lxm-home .lxm-hero{display:grid;grid-template-columns:1.15fr 1fr;min-height:88vh;background:#FBF8F4;}
.lxm-home .lxm-hero-media{position:relative;overflow:hidden;background:#F3ECE3;}
.lxm-home .lxm-hero-media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:78% center;}
.lxm-home .lxm-hero-panel{display:flex;align-items:center;padding:60px 56px;background:#FBF8F4;}
.lxm-home .lxm-hero-content{max-width:440px;text-align:right;}
.lxm-home .lxm-hero-content .lxm-eyebrow{justify-content:flex-start;}
.lxm-home .lxm-hero-content .lxm-eyebrow::before{display:none;}
.lxm-home .lxm-hero-content h1{
  font-size:clamp(34px,3.6vw,50px); line-height:1.18; color:#4a3b30;
  margin-top:18px;
}
.lxm-home .lxm-hero-content h1 em{font-style:normal;color:#c17b7e;}
.lxm-home .lxm-hero-content p{margin-top:22px;font-size:17px;color:#4a3b30;opacity:.82;max-width:400px;}
.lxm-home .lxm-hero-actions{margin-top:32px;display:flex;gap:14px;flex-wrap:wrap;}
@media(max-width:900px){
  .lxm-home .lxm-hero{grid-template-columns:1fr;min-height:auto;}
  .lxm-home .lxm-hero-media{aspect-ratio:4/3;}
  .lxm-home .lxm-hero-panel{padding:44px 28px;}
  .lxm-home .lxm-hero-content{max-width:100%;}
}

.lxm-home .lxm-trust{background:var(--cream-2); padding:34px 0;}
.lxm-home .lxm-trust-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;text-align:center;}
.lxm-home .lxm-trust-item{display:flex;flex-direction:column;align-items:center;gap:10px;font-size:14px;font-weight:600;color:var(--taupe-dark);}
.lxm-home .lxm-trust-item svg{width:26px;height:26px;stroke:var(--rose-dark);}
@media(max-width:760px){.lxm-home .lxm-trust-grid{grid-template-columns:repeat(2,1fr);row-gap:26px;}}

.lxm-home .lxm-products-scroller{
  display:flex; gap:26px; overflow-x:auto; scroll-snap-type:x mandatory;
  padding:8px 4px 26px; margin:0 -4px;
  scrollbar-width:thin; scrollbar-color:var(--rose) transparent;
}
.lxm-home .lxm-products-scroller::-webkit-scrollbar{height:6px;}
.lxm-home .lxm-products-scroller::-webkit-scrollbar-thumb{background:rgba(139,112,96,.25);border-radius:99px;}
.lxm-home .lxm-products-scroller::-webkit-scrollbar-track{background:transparent;}
.lxm-home .lxm-scroll-hint{text-align:center;font-size:13px;opacity:.55;margin-top:2px;display:flex;align-items:center;justify-content:center;gap:8px;}
.lxm-home .lxm-scroll-hint svg{width:14px;height:14px;}
.lxm-home .lxm-pcard{
  background:var(--white); border-radius:22px; overflow:hidden; box-shadow:var(--shadow);
  display:flex;flex-direction:column; transition:transform .35s ease, box-shadow .35s ease;
  border:1px solid rgba(139,112,96,.08);
  flex:0 0 auto; width:320px; scroll-snap-align:start;
}
.lxm-home .lxm-pcard:hover{transform:translateY(-8px); box-shadow:0 18px 50px rgba(107,86,70,.16);}
.lxm-home .lxm-pcard-img{aspect-ratio:1/1; display:block;position:relative;overflow:hidden;background:var(--cream-2);}
.lxm-home .lxm-pcard-img img{width:100%;height:100%;object-fit:cover;}
.lxm-home .lxm-pcard-badge{position:absolute;top:16px;inset-inline-start:16px;background:var(--rose);color:#fff;font-size:11.5px;font-weight:700;padding:6px 13px;border-radius:999px;letter-spacing:.03em;}
.lxm-home .lxm-pcard-body{padding:24px 22px 26px;display:flex;flex-direction:column;gap:10px;flex:1;}
.lxm-home .lxm-pcard-body h3{font-size:20px;color:var(--taupe-dark);}
.lxm-home .lxm-pcard-body p.lxm-tag{font-size:14px; color:var(--rose-dark); font-weight:600;}
.lxm-home .lxm-pcard-body p.lxm-desc{font-size:14px;opacity:.75;flex:1;}
.lxm-home .lxm-pcard-foot{display:flex;align-items:center;justify-content:space-between;margin-top:6px;flex-wrap:wrap;gap:10px;}
.lxm-home .lxm-price{font-size:19px;font-weight:700;color:var(--taupe-dark);font-family:'Frank Ruhl',serif;white-space:nowrap;direction:ltr;unicode-bidi:isolate;}
@media(max-width:600px){.lxm-home .lxm-pcard{width:78vw;}}

.lxm-home .lxm-film{padding-top:0;}
.lxm-home .lxm-film-frame{position:relative;aspect-ratio:16/9;border-radius:26px;overflow:hidden;box-shadow:var(--shadow);}
.lxm-home .lxm-film-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;background:#000;}
.lxm-home .lxm-film-scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0),rgba(0,0,0,.5) 88%);pointer-events:none;}
.lxm-home .lxm-film-caption{position:absolute;bottom:22px;inset-inline-start:0;inset-inline-end:0;text-align:center;color:var(--cream);font-weight:600;font-size:14.5px;letter-spacing:.02em;}
@media(max-width:760px){.lxm-home .lxm-film-frame{aspect-ratio:9/12;}}

.lxm-home .lxm-story{background:var(--cream-2);}
/* Single column since the decorative mark was removed — a two-column grid would
   leave the copy stranded in half the width with nothing beside it. */
.lxm-home .lxm-story-grid{display:block;max-width:760px;margin:0 auto;}
.lxm-home .lxm-story-text .lxm-eyebrow{justify-content:flex-start;}
.lxm-home .lxm-story-text .lxm-eyebrow::before{display:none;}
.lxm-home .lxm-story-text h2{font-size:clamp(26px,3.6vw,36px);margin-top:16px;color:var(--taupe-dark);}
.lxm-home .lxm-story-text p{margin-top:18px;font-size:16.5px;opacity:.85;}
.lxm-home .lxm-value-list{margin-top:28px;display:flex;flex-direction:column;gap:16px;}
.lxm-home .lxm-value-item{display:flex;gap:14px;align-items:flex-start;}
.lxm-home .lxm-value-item .lxm-dot{flex:none;width:34px;height:34px;border-radius:50%;background:var(--rose-soft);display:flex;align-items:center;justify-content:center;color:var(--rose-dark);font-size:15px;}
.lxm-home .lxm-value-item div p{font-size:15px;opacity:.8;margin-top:2px;}
.lxm-home .lxm-value-item div strong{font-size:16px;color:var(--taupe-dark);}


.lxm-home .lxm-reveal{opacity:0; transform:translateY(18px); transition:opacity .7s ease, transform .7s ease;}
.lxm-home .lxm-reveal.lxm-in{opacity:1; transform:translateY(0);}
@media (prefers-reduced-motion: reduce){
  .lxm-home .lxm-reveal{opacity:1; transform:none; transition:none;}
}
</style>

{%- liquid
  assign p_bag = all_products['תיק-חיתולים-3-ב-1-luxamom']
  assign p_warmer = all_products['מחמם-בקבוק-usb-נייד-luxamom']
  assign p_cushion = all_products['כרית-מגן-ראש-לפעוט-luxamom']
  assign p_belt = all_products['מגן-בטן-luxamom']
  assign p_sling = all_products['מנשא-חיבוק-luxamom']
-%}

<div class="lxm-home">

<section class="lxm-hero">
  <div class="lxm-hero-media">
    <img src="{{ 'luxamom-hero.png' | asset_url }}" alt="אמא מחבקת את תינוקה באור רך">
  </div>
  <div class="lxm-hero-panel">
    <div class="lxm-hero-content">
      <p class="lxm-eyebrow">לאמהות עם תינוקות</p>
      <h1>נוחות בכל רגע,<br>מהרגע <em>הראשון</em></h1>
      <p>מוצרים חכמים לאמהות — פותרים את הכאב היומיומי האמיתי, בעיצוב שסוף סוף מרגיש כמו מותג אמיתי.</p>
      <div class="lxm-hero-actions">
        <a href="#products" class="lxm-btn lxm-btn-primary">לגלות את הקולקציה</a>
        <a href="#story" class="lxm-btn lxm-btn-outline">הסיפור שלנו</a>
      </div>
    </div>
  </div>
</section>

<section class="lxm-trust">
  <div class="lxm-wrap lxm-trust-grid">
    <div class="lxm-trust-item lxm-reveal">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z"/><circle cx="7.5" cy="18.5" r="1.8"/><circle cx="17.5" cy="18.5" r="1.8"/></svg>
      משלוח חינם תמיד
    </div>
    <div class="lxm-trust-item lxm-reveal">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
      נבדק ובטוח לתינוקות
    </div>
    <div class="lxm-trust-item lxm-reveal">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
      30 יום להחזרה
    </div>
    <div class="lxm-trust-item lxm-reveal">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
      עוצב עם ובשביל אמהות
    </div>
  </div>
</section>

<section class="lxm-section" id="products">
  <div class="lxm-wrap">
    <div class="lxm-section-head lxm-reveal">
      <p class="lxm-eyebrow">הקולקציה שלנו</p>
      <h2>חמישה מוצרים. כאב אחד פחות בכל יום.</h2>
      <p>לא עוד "עוד דבר לתיק". כל מוצר נבנה סביב רגע ספציפי ביום של אמא.</p>
    </div>
    <div class="lxm-products-scroller">

      <div class="lxm-pcard lxm-reveal">
        <a href="{{ p_bag.url | default: '#' }}" class="lxm-pcard-img">
          <span class="lxm-pcard-badge">מוצר דגל</span>
          <img src="{{ 'luxamom-bag.png' | asset_url }}" alt="תיק חיתולים 3-ב-1 LUXAMOM">
        </a>
        <div class="lxm-pcard-body">
          <p class="lxm-tag">תיק חיתולים 3-ב-1</p>
          <h3><a href="{{ p_bag.url | default: '#' }}">כל מה שצריך ליציאה מהבית, על הגב</a></h3>
          <p class="lxm-desc">תיק גב שנפתח לתחנת החתלה ניידת, עם תאים שומרי חום לבקבוקים ורצועות נוחות שנתלות על העגלה. עיצוב שלא נראה כמו תיק תינוק.</p>
          <div class="lxm-pcard-foot">
            <span class="lxm-price">₪349</span>
            <a href="{{ p_bag.url | default: '#' }}" class="lxm-btn lxm-btn-outline" style="padding:11px 24px;font-size:14px;">לצפייה במוצר</a>
          </div>
        </div>
      </div>

      {%- comment -%}
        The sling card reads its image and price from the product itself rather
        than from hard-coded values, so a price change in the admin can't drift
        away from what the home page advertises.
      {%- endcomment -%}
      {% if p_sling != blank %}
        <div class="lxm-pcard lxm-reveal">
          <a href="{{ p_sling.url }}" class="lxm-pcard-img">
            <span class="lxm-pcard-badge">חדש</span>
            <img src="{{ p_sling.featured_image | image_url: width: 700 }}" alt="{{ p_sling.featured_image.alt | default: p_sling.title | escape }}" loading="lazy">
          </a>
          <div class="lxm-pcard-body">
            <p class="lxm-tag">מנשא חיבוק</p>
            <h3><a href="{{ p_sling.url }}">התינוק צמוד, היד שלך פנויה</a></h3>
            <p class="lxm-desc">מנשא סלינג לכתף אחת עם רצועה רחבה ומרופדת ובטנת רשת נושמת. מ-3 חודשים ועד 20 ק״ג, ומתקפל לתוך התיק.</p>
            <div class="lxm-pcard-foot">
              <span class="lxm-price">{{ p_sling.price | money_without_trailing_zeros }}</span>
              <a href="{{ p_sling.url }}" class="lxm-btn lxm-btn-outline" style="padding:11px 24px;font-size:14px;">לצפייה במוצר</a>
            </div>
          </div>
        </div>
      {% endif %}

      {% if p_belt != blank %}
        <div class="lxm-pcard lxm-reveal">
          <a href="{{ p_belt.url }}" class="lxm-pcard-img">
            <span class="lxm-pcard-badge">חדש</span>
            <img src="{{ p_belt.featured_image | image_url: width: 700 }}" alt="{{ p_belt.featured_image.alt | default: p_belt.title | escape }}" loading="lazy">
          </a>
          <div class="lxm-pcard-body">
            <p class="lxm-tag">מגן בטן</p>
            <h3><a href="{{ p_belt.url }}">החגורה במקום, הנסיעה נוחה</a></h3>
            <p class="lxm-desc">מחזיק את חגורת המותן מתחת לבטן ועל האגן, כדי שלא תטפס ותלחץ בכל נסיעה. מותקן בשניות ועובר בין רכבים.</p>
            <div class="lxm-pcard-foot">
              <span class="lxm-price">{{ p_belt.price | money_without_trailing_zeros }}</span>
              <a href="{{ p_belt.url }}" class="lxm-btn lxm-btn-outline" style="padding:11px 24px;font-size:14px;">לצפייה במוצר</a>
            </div>
          </div>
        </div>
      {% endif %}

      <div class="lxm-pcard lxm-reveal">
        <a href="{{ p_warmer.url | default: '#' }}" class="lxm-pcard-img">
          <img src="{{ 'luxamom-warmer.png' | asset_url }}" alt="מחמם בקבוק USB נייד LUXAMOM">
        </a>
        <div class="lxm-pcard-body">
          <p class="lxm-tag">מחמם בקבוק נייד</p>
          <h3><a href="{{ p_warmer.url | default: '#' }}">בקבוק חם, בכל מקום</a></h3>
          <p class="lxm-desc">צג דיגיטלי עם 21 רמות חום, עובד מכל מקור USB, קל וקטן לתיק. בלי לחכות ובלי לחפש שקע באמצע הלילה.</p>
          <div class="lxm-pcard-foot">
            <span class="lxm-price">₪119</span>
            <a href="{{ p_warmer.url | default: '#' }}" class="lxm-btn lxm-btn-outline" style="padding:11px 24px;font-size:14px;">לצפייה במוצר</a>
          </div>
        </div>
      </div>

      <div class="lxm-pcard lxm-reveal">
        <a href="{{ p_cushion.url | default: '#' }}" class="lxm-pcard-img">
          <img src="{{ 'luxamom-cushion.png' | asset_url }}" alt="כרית מגן ראש לפעוט LUXAMOM">
        </a>
        <div class="lxm-pcard-body">
          <p class="lxm-tag">כרית מגן ראש לפעוט</p>
          <h3><a href="{{ p_cushion.url | default: '#' }}">הצעדים הראשונים, בלי הלב בגרון</a></h3>
          <p class="lxm-desc">בולמת נפילות לאחור בתקופת ההליכה הראשונה. קלה כל כך שהתינוק שוכח שהיא שם — ועיצוב מתוק שאמהות מצלמות.</p>
          <div class="lxm-pcard-foot">
            <span class="lxm-price">₪99</span>
            <a href="{{ p_cushion.url | default: '#' }}" class="lxm-btn lxm-btn-outline" style="padding:11px 24px;font-size:14px;">לצפייה במוצר</a>
          </div>
        </div>
      </div>

    </div>
    <p class="lxm-scroll-hint lxm-reveal">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg>
      גררו לעוד מוצרים
    </p>
  </div>
</section>

{%- comment -%}
  The bundle used to be a second, near-identical copy of snippets/luxamom-bundle
  living inside this file, which meant every change to the discount ladder had
  to be made twice — and drifted the moment it wasn't. It now renders the same
