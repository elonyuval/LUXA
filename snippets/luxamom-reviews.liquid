{%- comment -%}
  Renders approved reviews from the product metafield custom.reviews (JSON list).
  Each entry: { "name": "...", "rating": 5, "body": "...", "date": "2026-08-04" }

  Two modes:
    (default)      — the reviews for the product being viewed.
    mode: 'home'   — a cross-product wall, `per_product` reviews from each
                     product (2 by default), each card naming what it is about.

  With nothing to show the snippet renders nothing at all. An empty-state card
  advertises the absence of reviews, which reads as a brand-new shop; the review
  form on the product page is the place to invite one.
{%- endcomment -%}

{%- liquid
  assign rv_mode = mode | default: 'product'
  assign rv_per_product = per_product | default: 2
-%}

<style>
.lxm-rv-summary{max-width:560px;margin:0 auto 26px;text-align:center;}
.lxm-rv-avg{display:flex;align-items:baseline;justify-content:center;gap:10px;flex-wrap:wrap;}
.lxm-rv-avg-num{font-family:'Frank Ruhl',serif;font-size:40px;font-weight:700;color:var(--taupe-dark,#6b5646);direction:ltr;unicode-bidi:isolate;}
.lxm-rv-avg-stars{color:var(--rose,#D9989A);font-size:20px;letter-spacing:2px;direction:ltr;unicode-bidi:isolate;}
.lxm-rv-avg-count{font-size:14px;opacity:.7;width:100%;margin-top:4px;}
.lxm-rv-list{max-width:760px;margin:0 auto;display:flex;flex-direction:column;gap:16px;}
.lxm-rv-grid{max-width:940px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:16px;}
.lxm-rv-card{background:var(--white,#FBF8F4);border:1px solid rgba(139,112,96,.14);border-radius:20px;padding:24px 26px;box-shadow:0 14px 36px rgba(107,86,70,.07);}
.lxm-rv-product{font-size:12.5px;font-weight:600;color:var(--rose-dark,#c17b7e);margin-bottom:10px;display:block;}
.lxm-rv-product:hover{text-decoration:underline;}
.lxm-rv-head{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:10px;}
.lxm-rv-avatar{width:42px;height:42px;border-radius:50%;background:var(--rose-soft,#f1dcdb);color:var(--rose-dark,#c17b7e);display:flex;align-items:center;justify-content:center;font-family:'Frank Ruhl',serif;font-size:18px;font-weight:700;flex:none;}
.lxm-rv-who{flex:1;min-width:0;}
.lxm-rv-name{font-size:15px;font-weight:700;color:var(--taupe-dark,#6b5646);}
.lxm-rv-stars{color:var(--rose,#D9989A);font-size:14px;letter-spacing:2px;direction:ltr;unicode-bidi:isolate;}
.lxm-rv-date{font-size:12.5px;opacity:.55;}
.lxm-rv-body{font-size:16px;line-height:1.75;}
@media(max-width:760px){.lxm-rv-grid{grid-template-columns:1fr;}}
@media(max-width:600px){.lxm-rv-card{padding:20px;}}
</style>

{%- if rv_mode == 'home' -%}

  {%- liquid
    assign rv_bag = all_products['תיק-חיתולים-3-ב-1-luxamom']
    assign rv_sling = all_products['מנשא-חיבוק-luxamom']
    assign rv_warmer = all_products['מחמם-בקבוק-usb-נייד-luxamom']
    assign rv_cushion = all_products['כרית-מגן-ראש-לפעוט-luxamom']
  -%}

  {%- comment -%}
    Captured first so the section can be skipped entirely when no product has a
    review yet, instead of leaving a heading over an empty strip.
  {%- endcomment -%}
  {%- capture rv_cards -%}
    {%- for n in (1..4) -%}
      {%- case n -%}
        {%- when 1 -%}{%- assign rv_p = rv_bag -%}
        {%- when 2 -%}{%- assign rv_p = rv_sling -%}
        {%- when 3 -%}{%- assign rv_p = rv_warmer -%}
        {%- when 4 -%}{%- assign rv_p = rv_cushion -%}
      {%- endcase -%}
      {%- if rv_p == blank -%}{%- continue -%}{%- endif -%}
      {%- assign rv_list = rv_p.metafields.custom.reviews.value -%}
      {%- if rv_list == blank -%}{%- continue -%}{%- endif -%}
      {%- for r in rv_list limit: rv_per_product -%}
        <div class="lxm-rv-card">
          <a class="lxm-rv-product" href="{{ rv_p.url }}">{{ rv_p.title | remove: ' LUXAMOM' }}</a>
          <div class="lxm-rv-head">
            <div class="lxm-rv-avatar">{{ r.name | strip | slice: 0 }}</div>
            <div class="lxm-rv-who">
              <div class="lxm-rv-name">{{ r.name }}</div>
              <div class="lxm-rv-stars">{% for i in (1..5) %}{% if i <= r.rating %}★{% else %}☆{% endif %}{% endfor %}</div>
            </div>
            {%- if r.date != blank -%}
              <span class="lxm-rv-date">{{ r.date | date: '%d.%m.%Y' }}</span>
            {%- endif -%}
          </div>
          <p class="lxm-rv-body">{{ r.body }}</p>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign rv_cards = rv_cards | strip -%}

  {%- if rv_cards != blank -%}
    <section class="lxm-section" id="reviews">
      <div class="lxm-wrap">
        <div class="lxm-section-head lxm-reveal">
          <p class="lxm-eyebrow">חוות דעת</p>
          <h2>מה אומרות עלינו אמהות</h2>
        </div>
        <div class="lxm-rv-grid">{{ rv_cards }}</div>
      </div>
    </section>
  {%- endif -%}

{%- else -%}

  {%- assign lxr = product.metafields.custom.reviews.value -%}
  {%- if lxr and lxr.size > 0 -%}
    {%- assign lxr_total = 0 -%}
    {%- for r in lxr -%}
      {%- assign lxr_total = lxr_total | plus: r.rating -%}
    {%- endfor -%}
    {%- assign lxr_avg = lxr_total | times: 1.0 | divided_by: lxr.size -%}
    {%- assign lxr_avg_round = lxr_avg | round -%}

    <div class="lxm-rv-summary">
      <div class="lxm-rv-avg">
        <span class="lxm-rv-avg-num">{{ lxr_avg | round: 1 }}</span>
        <span class="lxm-rv-avg-stars">{% for i in (1..5) %}{% if i <= lxr_avg_round %}★{% else %}☆{% endif %}{% endfor %}</span>
        <span class="lxm-rv-avg-count">
          {%- if lxr.size == 1 -%}מתוך ביקורת אחת{%- else -%}מתוך {{ lxr.size }} ביקורות{%- endif -%}
        </span>
      </div>
    </div>

    <div class="lxm-rv-list">
      {%- for r in lxr -%}
        <div class="lxm-rv-card">
          <div class="lxm-rv-head">
            <div class="lxm-rv-avatar">{{ r.name | strip | slice: 0 }}</div>
            <div class="lxm-rv-who">
              <div class="lxm-rv-name">{{ r.name }}</div>
              <div class="lxm-rv-stars">{% for i in (1..5) %}{% if i <= r.rating %}★{% else %}☆{% endif %}{% endfor %}</div>
            </div>
            {%- if r.date != blank -%}
              <span class="lxm-rv-date">{{ r.date | date: '%d.%m.%Y' }}</span>
            {%- endif -%}
          </div>
          <p class="lxm-rv-body">{{ r.body }}</p>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

{%- endif -%}
